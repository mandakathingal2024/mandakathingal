rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Members: public read (website displays family tree), authenticated write
    match /members/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Events: public read, authenticated write
    match /events/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Gallery: public read, authenticated write
    match /gallery/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Executives: public read, authenticated write
    match /executives/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Website Content: public read, authenticated write
    match /websiteContent/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Gmail access list: read only by authenticated users, write by authenticated
    match /gmail/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admins: only server-side access (API routes)
    // Client reads are needed for session verification
    match /admins/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Activity Log: only authenticated reads and writes
    match /activityLog/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
