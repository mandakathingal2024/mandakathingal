rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Members: readable only by allow-listed family members (the `member`
    // custom claim, granted server-side via /api/member-access after the email
    // is verified against the gmail allow-list) or admins. A plain Google
    // sign-in is NOT enough — this enforces the allow-list as a real boundary.
    // All writes go through server-side Admin SDK (bypasses rules).
    match /members/{docId} {
      allow read: if request.auth != null
        && (request.auth.token.member == true || request.auth.token.admin == true);
      allow write: if false;
    }

    // Events: public read (displayed on homepage)
    // Writes via Admin SDK only
    match /events/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Gallery: public read (displayed on gallery page)
    // Writes via Admin SDK only
    match /gallery/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Executives: public read (displayed on homepage & executives page)
    // Writes via Admin SDK only
    match /executives/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Website Content: public read (hero, about, milestones)
    // Writes via Admin SDK only
    match /websiteContent/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Gmail access list: admin-only reads. The public allow-list check now
    // happens server-side (/api/member-access via Admin SDK), so regular users
    // no longer need — or get — read access to the full email list.
    // Writes via Admin SDK only.
    match /gmail/{docId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }

    // Admins: contains password hashes — readable ONLY by actual admins,
    // identified by the `admin` custom claim on their Firebase token (minted
    // at admin login). Regular Google sign-in users cannot read this.
    // Writes via Admin SDK only — prevents privilege escalation.
    match /admins/{docId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }

    // Activity Log: admin-only reads (admin dashboard)
    // Writes via Admin SDK only
    match /activityLog/{docId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
