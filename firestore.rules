rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Members: only authenticated users can read (Gmail sign-in required)
    // All writes go through server-side Admin SDK (bypasses rules)
    match /members/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Events: public read (displayed on homepage)
    // Writes via Admin SDK only
    match /events/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Gallery: public read (displayed on gallery page)
    // Writes via Admin SDK only
    match /gallery/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Executives: public read (displayed on homepage & executives page)
    // Writes via Admin SDK only
    match /executives/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Website Content: public read (hero, about, milestones)
    // Writes via Admin SDK only
    match /websiteContent/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Gmail access list: authenticated users can read (to check access)
    // Writes via Admin SDK only
    match /gmail/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Admins: authenticated reads (needed for admin dashboard)
    // Writes via Admin SDK only — prevents privilege escalation
    match /admins/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Activity Log: authenticated reads (admin dashboard)
    // Writes via Admin SDK only
    match /activityLog/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
